<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CookingPal.Pages.FavoritesPage"
             Title="FavoritesPage"
             BackgroundColor="#fff5e1"
             Padding="20">
    <ScrollView>
        <VerticalStackLayout Spacing="20">
            <Label Text="❤️ Your Favorite Recipes"
                   FontSize="22"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   TextColor="#126A5A"> 
                
            </Label>
            <CollectionView x:Name="FavoritesList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame  BackgroundColor="White"
                               CornerRadius="10"
                               Padding="10"
                               Margin="0,5">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold">
                                    
                                </Label>
                                <Label
                                    Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="Gray" >
                                    
                                </Label>
                            </VerticalStackLayout>
                            
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button
                Text="Back"
        BackgroundColor="#cccccc"
        TextColor="Black"
        Clicked="OnBackClicked"
        CornerRadius="12"
        Margin="0,20,0,0"> 
                
            </Button>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>