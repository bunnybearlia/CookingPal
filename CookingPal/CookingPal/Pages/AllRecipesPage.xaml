<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CookingPal.Pages.AllRecipesPage"
             Title="All Recipes"
             BackgroundColor="#fff5e1"
             Padding="10">
    
    <CollectionView x:Name="RecipesCollectionView"
                    SelectionMode="Single"
                    SelectionChanged="OnRecipeSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame BorderColor="#ccc" BackgroundColor="White" CornerRadius="12" Margin="5" Padding="10">
                    <StackLayout>
                        <Label
                            Text="{Binding RecipeName}" FontSize="20" FontAttributes="Bold" TextColor="#126A5A" >
                        </Label>
                        <Label
                             Text="{Binding Category}" FontSize="14" TextColor="Gray">
                            
                        </Label>
                    </StackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>
</ContentPage>
